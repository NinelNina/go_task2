# === Специфичные файлы GoLand / JetBrains IDE ===
.idea/
*.iw
*.iws
out/
# Если вы хотите делиться настройками проекта с командой, 
# вы можете раскомментировать строку ниже, чтобы игнорировать только личные настройки:
# .idea/workspace.xml

# === Компилируемые бинарные файлы и логи ===
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Файлы покрытия тестов (Сoverage профили)
*.coverprofile
coverage.*
profile.cov

# === Зависимости и рабочие пространства ===
# Игнорируйте локальное рабочее пространство Go (если используете go.work)
go.work.sum

# По умолчанию папка vendor не отслеживается, но ее можно закомментировать (# vendor/),
# если вашей команде обязательно нужно хранить все зависимости в репозитории.
vendor/

# === Окружение и секреты ===
.env
.env.*
!.env.example

# === Системные файлы ===
.DS_Store
Thumbs.db
